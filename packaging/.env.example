# packaging/make_exe.py 配置
# 复制此文件为 .env 并填入你的配置

# Inno Setup 6 编译器路径
# 留空则自动搜索常见安装位置（不支持 Inno Setup 5）
ISCC_PATH=

# 生成含游戏完整包时必填；只生成独立汉化包时可留空
# 含游戏完整包的官方原版来源目录。make_exe.py 会在编译前校验整棵文件树；
# 必须由对应版本官方安装包全新安装，且从未启动游戏、安装 mod 或写入存档。
ORIGINAL_GAME_FOLDER=

# 输出文件名是否包含日期后缀，true/false（make_zip.py 默认 true，make_exe.py 默认 false）。
# make_zip.py 的 --include-date / --no-date 会覆盖此项。
INCLUDE_DATE=true

# 游戏版本号覆盖（留空则从 localization/localization_version.json 自动读取）
GAME_VERSION=

# 汉化版本号覆盖（留空则从 localization/localization_version.json 自动读取）
APP_VERSION=

# 各 git 分支对应的变体名（安装包名称后缀）
BRANCH_VARIANT_master=(黑体版)
BRANCH_VARIANT_font-simsong=(宋体版)
BRANCH_VARIANT_font-zongyi=(综艺体版)
BRANCH_VARIANT_startup-optimization=(优化测试版)
